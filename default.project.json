{
  "name": "rubluks",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$path": "src/shared",
      "$ignoreUnknownInstances": true
    },

    "ServerScriptService": {
      "$path": "src/server",
      "$ignoreUnknownInstances": true
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/client",
        "$ignoreUnknownInstances": true
      }
    },

    "Workspace": {
      "$ignoreUnknownInstances": true
    },

    "Lighting": {
      "$ignoreUnknownInstances": true
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },

    "Players": {
      "$className": "Players",
      "$properties": {
        "MaxPlayers": 60
      }
    },

    "Teams": {
      "$className": "Teams"
    },

    "MaterialService": {
      "$className": "MaterialService"
    },

    "NetworkClient": {
      "$className": "NetworkClient"
    },

    "ReplicatedFirst": {
      "$className": "ReplicatedFirst"
    },

    "ServerStorage": {
      "$className": "ServerStorage"
    },

    "StarterGui": {
      "$className": "StarterGui"
    },

    "StarterPack": {
      "$className": "StarterPack"
    },

    "TextChatService": {
      "$className": "TextChatService"
    }
  }
}